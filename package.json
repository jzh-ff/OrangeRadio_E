{
  "name": "orangesea",
  "productName": "OrangeSea",
  "version": "1.0.0",
  "description": "橘子海 - Windows 沉浸式音乐播放器，日落渐变暗色视觉，融合桌面模式、歌词舞台、粒子视觉和 3D 歌单架。",
  "author": "OrangeSea",
  "license": "GPL-3.0-only",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never",
    "build:win:dir": "electron-builder --win dir",
    "build:win:internal-beta": "electron-builder --config electron-builder.internal-beta.json --win nsis --publish never",
    "test": "node scripts/run-tests.js"
  },
  "build": {
    "appId": "com.orangesea.desktop",
    "productName": "OrangeSea",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "build/**/*",
      "cuefield/**/*",
      "server.js",
      "server/**/*",
      "*-api.js",
      "qishui-audio-decryptor/**/*",
      "dj-analyzer.js",
      "local-library.js",
      "LICENSE",
      "NOTICE.md",
      "docs/THIRD_PARTY_PORTS.md",
      "package.json",
      "!desktop/wallpaper-preload.js",
      "!public/wallpaper.html",
      "!public/index.*.html",
      "public/index.html"
    ],
    "asar": false,
    "mac": {
      "icon": "build/icon-mac.png",
      "target": [
        { "target": "dmg", "arch": ["universal"] }
      ],
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false
    },
    "win": {
      "executableName": "OrangeSea",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OrangeSea",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "artifactName": "OrangeSea-${version}-Setup.${ext}"
    }
  },
  "mineradio": {
    "update": {
      "provider": "none",
      "preview": false,
      "preferMirrors": false,
      "mirrors": []
    },
    "runtimeName": "OrangeSea",
    "appUserModelId": "com.orangesea.desktop"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "NeteaseCloudMusicApi": "^4.32.0",
    "node-id3": "^0.2.9"
  },
  "overrides": {
    "axios": "1.18.1",
    "body-parser": "1.20.6",
    "music-metadata": "11.14.0"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2"
  }
}
